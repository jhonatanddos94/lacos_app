{
  "name": "lacos-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Code foundation for the Laços multi-tenant backend",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node tests/run.js",
    "validate": "npm run lint && npm run test",
    "test:staging": "node tests/staging/smoke.staging.js",
    "test:staging:baseline": "node tests/staging/cross_tenant_baseline.staging.js",
    "seed:staging": "node tests/staging/seed_cross_tenant.staging.js",
    "migrate:staging:working-hours-acl": "node tests/staging/migrate_working_hours_acl.staging.js",
    "test:staging:working-hours-secure": "node tests/staging/working_hours_secure.staging.js"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  }
}
