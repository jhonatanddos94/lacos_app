# Copy values into Back4App Cloud Code environment variables.
# Never commit real secrets.

# Runtime mode: development | staging | production
LACOS_ENV=development

# Security posture for dual-run: permissive | enforcing
LACOS_SECURITY_MODE=permissive

# --- Firebase Admin (required for exchangeSession) ---
# Prefer one of the following (never commit real values):
#
# Option A — JSON string of the service account:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
#
# Option B — Base64 of the same JSON (recommended on dashboards that break newlines):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
#
# Optional override (defaults to project_id inside the service account):
# FIREBASE_PROJECT_ID=

# --- Local staging smoke / T1.S0 REST baseline (never commit real values) ---
# LACOS_STAGING_SMOKE=1
# LACOS_STAGING_APPLICATION_ID=
# LACOS_STAGING_SERVER_URL=https://parseapi.back4app.com
# LACOS_STAGING_CLIENT_KEY=
# LACOS_STAGING_MASTER_KEY=
# LACOS_PRODUCTION_APPLICATION_ID=gg8QDOwG2FI0lRFQ79cFDYxh61mRx2ECqGZSqhWb
# LACOS_STAGING_ID_TOKEN_VERIFIED=
# LACOS_STAGING_AUTH_MODE=parse_login
# LACOS_STAGING_USER_A_USERNAME=teste_a
# LACOS_STAGING_USER_A_PASSWORD=
# LACOS_STAGING_USER_B_USERNAME=teste_b
# LACOS_STAGING_USER_B_PASSWORD=
# LACOS_STAGING_ID_TOKEN_A=
# LACOS_STAGING_ID_TOKEN_B=
# LACOS_STAGING_SEED=1
